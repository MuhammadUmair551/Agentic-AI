NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# MONGODB_URI=

# Preferred configuration: choose the providers that are configured below.
# Provider names are comma-separated and must match these names exactly.
LLM_PROVIDERS=groq,gemini,ollama

# Groq (OpenAI-compatible API)
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=
LLM_GROQ_TIMEOUT_MS=30000

# Gemini (OpenAI-compatible API)
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash
LLM_GEMINI_TIMEOUT_MS=30000

# Ollama Cloud (use the OpenAI-compatible API URL for your Ollama Cloud account)
LLM_OLLAMA_BASE_URL=
LLM_OLLAMA_API_KEY=
LLM_OLLAMA_MODEL=
LLM_OLLAMA_TIMEOUT_MS=30000

# Optional legacy single-provider settings. Used when credentials are supplied.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=example-model
# LLM_TIMEOUT_MS=30000

# Optional additional fallback provider (name inferred from the URL host when possible).
# FALLBACK_LLM_BASE_URL=https://api.example.com/v1
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_MODEL=

# Route order is failover order. Keep a stronger model first for generation if preferred.
LLM_PROFILE_FAST=groq,gemini,ollama
LLM_PROFILE_GENERATE=gemini,groq,ollama
LLM_PROFILE_TOOLS=gemini,groq,ollama
LLM_COOLDOWN_MS=60000